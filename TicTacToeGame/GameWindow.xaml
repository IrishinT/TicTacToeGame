<Window x:Class="TicTacToeGame.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToeGame"
        mc:Ignorable="d"
        Title="Крестики-нолики" Height="480" Width="400"
        MinHeight="420" MinWidth="340">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   Text="Нажмите ''Начать игру''" />

        <UniformGrid x:Name="BoardGrid" Grid.Row="1" Rows="3" Columns="3">
            <Button x:Name="Cell0" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell1" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell2" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell3" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell4" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell5" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell6" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell7" FontSize="48" Margin="4" IsEnabled="False" />
            <Button x:Name="Cell8" FontSize="48" Margin="4" IsEnabled="False" />
        </UniformGrid>

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Уровень:"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       FontSize="16" />
                <ComboBox x:Name="DifficultyBox"
                          Width="160"
                          VerticalAlignment="Center"
                          FontSize="16"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Лёгкий" Tag="2" />
                    <ComboBoxItem Content="Средний" Tag="4" />
                    <ComboBoxItem Content="Невозможный" Tag="9" />
                </ComboBox>
            </StackPanel>
            <Button x:Name="NewGameButton"
                    Margin="0,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Content="Начать игру"
                    Click="NewGameButton_Click" />
        </StackPanel>
    </Grid>
</Window>
